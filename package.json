{
  "name": "blog-ashu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "figures": "esbuild scripts/render-figures.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=.figures.cjs --log-level=warning && node .figures.cjs && rm -f .figures.cjs",
    "og": "esbuild scripts/og.tsx --bundle --platform=node --format=cjs --jsx=automatic --external:satori --external:@resvg/resvg-js --outfile=.og.cjs --log-level=warning && node .og.cjs && rm -f .og.cjs",
    "md": "esbuild scripts/md.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=.md.cjs --log-level=warning && node .md.cjs && rm -f .md.cjs",
    "prebuild": "npm run figures && npm run og",
    "postbuild": "npm run md"
  },
  "dependencies": {
    "framer-motion": "^12.34.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "satori": "^0.12.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5"
  }
}
